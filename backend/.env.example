# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Server Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
# List origins separated by commas (e.g., https://your-frontend.vercel.app)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Database
# For SQLite (default): sqlite:///./data/insightforge.db
# For Postgres (Render): postgresql://user:password@hostname:port/dbname
DATABASE_URL=sqlite:///./data/insightforge.db

# Auth
JWT_SECRET=generate-a-secure-random-string-for-production
JWT_EXPIRE_HOURS=72

# Background Jobs (Optional, needs Redis)
REDIS_URL=redis://localhost:6379/0
